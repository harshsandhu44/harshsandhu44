# Keystatic GitHub mode. Written for you by the /keystatic/setup wizard in
# development — see "Content" in README.md. Copy all four into Vercel
# (Production and Preview) to enable CMS editing on the deployed site.
#
# Without them the site still builds and still reads its content; only
# /keystatic falls back to local mode, which cannot write on a read-only deploy.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Development only. Forces GitHub mode so the setup wizard is reachable before
# the App exists. Remove it once the four values above are filled in.
# KEYSTATIC_STORAGE=github
